# ── LLM provider: "openai" or "gemini" ─────────────────────────
# Defaults to openai when OPENAI_API_KEY is set, otherwise gemini.
LLM_PROVIDER=openai

# ── OpenAI (required when LLM_PROVIDER=openai) ──────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Gemini API (required when LLM_PROVIDER=gemini) ──────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Flask ────────────────────────────────────────────────────
# Keep false in production. Set true only during development.
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# Cross-origin: leave empty when the frontend uses the same origin as the backend (default).
# Set only when the frontend is hosted on another domain. Separate multiple origins with commas.
# Example: CORS_ORIGINS=https://shopsmart.example.com
CORS_ORIGINS=

# ── Rate limiting (maximum requests per 60 seconds) ────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10
RATE_LIMIT_CHAT=20
RATE_LIMIT_SEARCH=30
RATE_LIMIT_REFRESH=6

# ── AI chat session cache (LRU + TTL limits) ────────────────
# Maximum agent sessions kept in memory and their lifetime in seconds.
AGENT_CACHE_MAX=200
AGENT_CACHE_TTL=7200

# ── Auth / JWT ───────────────────────────────────────────────
# REQUIRED in production. If empty, the app generates and stores a local .jwt_secret (development only).
JWT_SECRET=
# Token lifetime in seconds. Defaults to 7 days.
JWT_EXPIRY_SECONDS=604800
# bcrypt work factor (4-15). Defaults to 12.
BCRYPT_ROUNDS=12

# ── Price Monitor (automatic background price updates) ─────────────────
PRICE_MONITOR_ENABLED=true
# Scan interval in seconds. Defaults to 6 hours.
PRICE_MONITOR_INTERVAL=21600
PRICE_MONITOR_INITIAL_DELAY=60
PRICE_MONITOR_PER_ITEM_DELAY=3
# Whether to run the monitor inside the web process.
# With multiple workers (gunicorn -w N), set false and run `python monitor.py`
# Start it separately to prevent each worker starting a duplicate monitor and scan.
PRICE_MONITOR_IN_PROCESS=true

# ── Production server (waitress) ─────────────────────────────
# Run `python serve.py` to start a production WSGI server instead of the development server (app.py).
SERVE_HOST=0.0.0.0
SERVE_THREADS=8

# ── Live notifications: Telegram (optional) ──────────────────────
# Telegram bot token. Each user enters their chat ID in settings.
TELEGRAM_BOT_TOKEN=

# ── Live notifications: SMTP email (optional) ────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Scraper: limit downloads from untrusted URLs ───────────
# Maximum scraped content size in bytes. Defaults to 5 MB.
SCRAPE_MAX_RESPONSE_BYTES=5242880

# ── Search: cache + rate limit (avoid DuckDuckGo HTTP 429 responses) ─
# Search result cache duration in seconds. Defaults to 5 minutes.
SEARCH_CACHE_TTL=300
# Maximum search calls per SEARCH_RATE_PERIOD.
SEARCH_RATE_MAX_CALLS=8
SEARCH_RATE_PERIOD=60
